<?xml version="1.0" encoding="utf-8"?>
<!--
  타이틀 화면 레이아웃
  - 배경: 가로형 타이틀 일러스트 (title_background.png)
  - 제목 "구르박스" + 버튼 "구르기" 를 세로로 묶어 상단(하늘 영역)에 배치
  - 버튼은 제목 바로 아래, 배경 투명
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 배경 일러스트: 화면을 꽉 채우되 비율 유지하며 잘라서 채움 -->
    <ImageView
        android:id="@+id/titleBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/title_background"
        android:contentDescription="구르박스 타이틀 배경" />

    <!-- 제목 + 버튼을 하나의 세로 묶음으로 상단 중앙에 배치 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 제목 "구르박스" -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="구르박스"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="#FFF0B8"
            android:shadowColor="#5A3410"
            android:shadowDx="0"
            android:shadowDy="6"
            android:shadowRadius="8"
            android:letterSpacing="0.05"
            android:includeFontPadding="false" />
        <!--
          폰트 교체 위치:
          Jua(주아체) 같은 둥근 폰트를 쓰려면
          res/font/jua.ttf 추가 후 아래 한 줄을 위 TextView에 넣으면 됨:
          android:fontFamily="@font/jua"
        -->

        <!-- 시작 버튼 "구르기": 제목 바로 아래, 배경 투명 -->
        <Button
            android:id="@+id/startButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:text="구르기"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:shadowColor="#5A3410"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="6"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:includeFontPadding="false" />

    </LinearLayout>

</FrameLayout>